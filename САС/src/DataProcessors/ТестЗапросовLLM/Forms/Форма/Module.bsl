
&НаКлиенте
Процедура Команда1НаСервере()
	
	Попытка
		Описание = ЯндексGPT.ПолучитьОписание("Яблоко", "Отец яблока");
		Если ЗначениеЗаполнено(Описание) Тогда
			Объект.Описание = Описание;
			Сообщить("Описание успешно получено и заполнено");
		Иначе
			Сообщить("Не удалось получить описание от API");
		КонецЕсли;
	Исключение
		Сообщить("Ошибка при получении описания: " + ОписаниеОшибки());
	КонецПопытки;
	// Вставить содержимое обработчика.
КонецПроцедуры

&НаКлиенте
Процедура Команда1(Команда)
	ОтправитьЗапос();
КонецПроцедуры  

&НаСервере
Функция ОтправитьЗапросКYandexGPT(ТекстЗапроса, APIКлюч, IDКаталога) Экспорт
	Попытка
		// Создаём HTTPS‑соединение
		Соединение = Новый HTTPСоединение(
		"llm.api.cloud.yandex.net",
		443,
		,
		,
		,
		60,
		Новый ЗащищенноеСоединениеOpenSSL()
		);
		
		// Формируем JSON‑тело запроса
		ДанныеJSON = Новый Структура;
		ДанныеJSON.Вставить("modelUri", "gpt://" + IDКаталога + "/yandexgpt/latest");
		
		Опции = Новый Структура;
		Опции.Вставить("stream", Ложь);           // Отключаем потоковую передачу
		Опции.Вставить("temperature", 0.6);     // Креативность ответа (0–1)
		Опции.Вставить("maxTokens", 1000);         // Макс. длина ответа в токенах
		ДанныеJSON.Вставить("completionOptions", Опции);
		
		Сообщения = Новый Массив;
		СообщениеПользователя = Новый Структура;
		СообщениеПользователя.Вставить("role", "user");
		СообщениеПользователя.Вставить("text", ТекстЗапроса);
		Сообщения.Добавить(СообщениеПользователя);
		ДанныеJSON.Вставить("messages", Сообщения);
		
		// Преобразуем структуру в JSON
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, ДанныеJSON);
		ТелоЗапроса = ЗаписьJSON.Закрыть();
		
		// Настраиваем HTTP‑запрос
		HTTPЗапрос = Новый HTTPRequest("/foundationModels/v1/completion");
		HTTPЗапрос.Заголовки.Вставить("Authorization", "Api-Key " + APIКлюч);
		HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/json");
		HTTPЗапрос.УстановитьТелоИзСтроки(ТелоЗапроса);
		
		
		// Отправляем запрос
		Ответ = Соединение.ОтправитьДляОбработки(HTTPЗапрос);
		
		Если Ответ.КодСостояния = 200 Тогда
			ТелоОтвета = Ответ.ПолучитьТелоКакСтроку();
			ЧтениеJSON = Новый ЧтениеJSON;
			ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
			ОтветJSON = ПрочитатьJSON(ЧтениеJSON);
			ЧтениеJSON.Закрыть();
			
			Если ОтветJSON.Свойство("result") И ОтветJSON.result.Свойство("alternatives") Тогда
				Возврат ОтветJSON.result.alternatives[0].message.text;
			Иначе
				Возврат "Ошибка: поле result не найдено в ответе";
			КонецЕсли;
		Иначе
			Возврат "Ошибка API: код " + Ответ.КодСостояния + ", тело: " + Ответ.ПолучитьТелоКакСтроку();
		КонецЕсли;
	Исключение
		Возврат "Ошибка выполнения: " + ОписаниеОшибки();
	КонецПопытки;
КонецФункции 

&НаКлиенте
Процедура ОтправитьЗапос();
	// Ваши данные из Яндекс Облака

	// Текст запроса к модели
	Запрос = "Напиши краткий отчёт о продажах за последний месяц в деловом стиле";
	
	// Отправляем запрос и получаем ответ
	Результат = ОтправитьЗапросКYandexGPT(Запрос, APIКлюч, IDКаталога);
	
	// Выводим результат
	Сообщить("Ответ Yandex GPT: " + Результат);
КонецПроцедуры
