Функция ПолучитьИнформациюИзОтчета(ДанныеОтчета) 
	
	Отчет = Неопределено;
	ОтчетСтруктура = Неопределено;
	Скриншот = Неопределено;
	
	ЧтениеZip = Новый ЧтениеZipФайла(ДанныеОтчета.ОткрытьПотокДляЧтения());
	Для Каждого Элемент Из ЧтениеZip.Элементы Цикл 
		Если Элемент.Имя = "report.json" Тогда
			
			ПутьКПапкеReportJson = ПолучитьИмяВременногоФайла();
			ЧтениеZip.Извлечь(Элемент, ПутьКПапкеReportJson);
			
			ЧтениеТекста = Новый ЧтениеТекста(ПутьКПапкеReportJson + ПолучитьРазделительПути() + "report.json", 
												КодировкаТекста.UTF8);
			Отчет = ЧтениеТекста.Прочитать();
			ЧтениеТекста.Закрыть();
			
			ЧтениеJson = Новый ЧтениеJSON();
			ЧтениеJson.ОткрытьФайл(ПутьКПапкеReportJson + ПолучитьРазделительПути() + "report.json");
			ОтчетСтруктура = ПрочитатьJSON(ЧтениеJson);			
			ЧтениеJson.Закрыть();
			
			УдалитьФайлы(ПутьКПапкеReportJson);
			
		ИначеЕсли Элемент.Имя = "screenshot.png" Тогда
			
			ПутьКПапкеScreenshot = ПолучитьИмяВременногоФайла();
			ЧтениеZip.Извлечь(Элемент, ПутьКПапкеScreenshot);
			Картинка = Новый ДвоичныеДанные(ПутьКПапкеScreenshot + ПолучитьРазделительПути() + "screenshot.png");
			Скриншот = Новый ХранилищеЗначения(Картинка);
			УдалитьФайлы(ПутьКПапкеScreenshot);
			
		Иначе
			// ничего не делаем. Других файлов в архиве нет.
		КонецЕсли;
	КонецЦикла;
	
	Возврат Новый Структура("Report, ReportStructure, Screenshot", Отчет, ОтчетСтруктура, Скриншот); 
	
КонецФункции

Функция НайтиХэш(ХэшОшибки) Экспорт 
	
	Рез = Неопределено;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Инциденты.Хэш КАК Хэш,
	|	Инциденты.Инцидент КАК Инцидент
	|ИЗ
	|	РегистрСведений.Инциденты КАК Инциденты
	|ГДЕ
	|	Инциденты.Хэш = &Хэш";
	
	Запрос.УстановитьПараметр("Хэш", ХэшОшибки);
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	Пока РезультатЗапроса.Следующий() Цикл
		Рез = РезультатЗапроса.Задача;	
	КонецЦикла;  
	
	Возврат Рез;
	
КонецФункции  

Функция ПолучитьИмяФайлаИзПути(ПолныйПуть)
	
	ПозицияРазделителя = СтрНайти(ПолныйПуть, "\", НаправлениеПоиска.СКонца);
    Если ПозицияРазделителя > 0 Тогда
        Возврат Сред(ПолныйПуть, ПозицияРазделителя + 1);
    Иначе
        Возврат ПолныйПуть;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Функция ПолучитьРасширениеФайла(ПолныйПуть)
    ПозицияТочки = СтрНайти(ПолныйПуть, ".", НаправлениеПоиска.СКонца);
    Если ПозицияТочки > 0 Тогда
        Возврат Сред(ПолныйПуть, ПозицияТочки);
    Иначе
        Возврат "";
    КонецЕсли;
КонецФункции


Процедура ОтправкаЗапросовYandexGPT() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИнцидентыКОбработкеYandexGPT.Инцидент КАК Инцидент,
	|	ИнцидентыКОбработкеYandexGPT.ОтветПолучен КАК ОтветПолучен,
	|	ИнцидентыКОбработкеYandexGPT.ТекстОтчетаJSON КАК ТекстОтчетаJSON
	|ИЗ
	|	РегистрСведений.ИнцидентыКОбработкеYandexGPT КАК ИнцидентыКОбработкеYandexGPT
	|ГДЕ
	|	НЕ ИнцидентыКОбработкеYandexGPT.ОтветПолучен";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ОтветYandexGPT = ЯндексGPT.ОтправитьЗапросКYandexGPT(
		"Разбери ошибку из текста JSON для 1С. Дай полный анализ, напиши рекомендации по исправлению. Классифицируй ошибки по видам (Программная или аналитическая). Дай развернутый ответ. Текст:" 
		+ Символы.ПС + ВыборкаДетальныеЗаписи.ТекстОтчетаJSON);
		
		МенеджерЗаписи = РегистрыСведений.ИнцидентыКОбработкеYandexGPT.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МенеджерЗаписи, ВыборкаДетальныеЗаписи); 
		МенеджерЗаписи.Прочитать();
		
		Если МенеджерЗаписи.Выбран() Тогда
			МенеджерЗаписи.ОтветПолучен = Истина;
			МенеджерЗаписи.Записать(Истина);
		КонецЕсли;
		
		ИнцидентОбъект = ВыборкаДетальныеЗаписи.Инцидент.ПолучитьОбъект();
		ИнцидентОбъект.ОтветYandexGPT = ОтветYandexGPT;
		ИнцидентОбъект.ОтветПолучен = Истина; 
		
		Попытка
			ИнцидентОбъект.Записать();
		Исключение 
			ИнфОш = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		
	КонецЦикла; 
	
КонецПроцедуры

