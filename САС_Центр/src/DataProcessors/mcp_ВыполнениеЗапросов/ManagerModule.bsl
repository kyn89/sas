Процедура ДобавитьИнструменты(Инструменты) Экспорт

	ДобавитьИнструментПроверитьЗапрос(Инструменты);
	ДобавитьИнструментПолучитьРезультатВыполненияЗапроса(Инструменты);

КонецПроцедуры

Функция ВыполнитьИнструмент(ИмяИнструмента, Аргументы) Экспорт

    Если ИмяИнструмента = "validate_query" Тогда
        Возврат ПроверитьЗапрос(Аргументы);
    ИначеЕсли ИмяИнструмента = "execute_query" Тогда
        Возврат ПолучитьРезультатВыполненияЗапроса(Аргументы);
    Иначе
        ВызватьИсключение "Неизвестный инструмент: " + ИмяИнструмента;
    КонецЕсли;

КонецФункции

#Область ИнструментПроверитьЗапрос

Процедура ДобавитьИнструментПроверитьЗапрос(Инструменты)

	// Создаем описания параметров для инструмента validate_query
	МассивПараметров = Новый Массив;
	
	// Параметр query - текст запроса 1С для проверки
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"query",
		"string",
		"Текст запроса 1С (на языке запросов 1С) для проверки синтаксиса",
		,
		Истина
	));
	
	// Создаем JSON-схему параметров
	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);
	
	// Добавляем инструмент в таблицу
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"validate_query",
		"Проверка синтаксиса запроса 1С без выполнения",
		СхемаПараметров
	);

КонецПроцедуры

Функция ПроверитьЗапрос(Аргументы)

	ТекстЗапроса = Аргументы.query;
	
	Попытка
		Схема = Новый СхемаЗапроса;
		Схема.УстановитьТекстЗапроса(ТекстЗапроса);
		
		Результат = Новый Структура;
		Результат.Вставить("valid", Истина);
		Результат.Вставить("message", "Синтаксис запроса корректен");
		
		Возврат mcp_ОбщегоНазначения.СтруктураВJSON(Результат);
		
	Исключение
		Результат = Новый Структура;
		Результат.Вставить("valid", Ложь);
		Результат.Вставить("message", ОписаниеОшибки());
		
		Возврат mcp_ОбщегоНазначения.СтруктураВJSON(Результат);
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область ИнструментРезультатВыполненияЗапроса

Процедура ДобавитьИнструментПолучитьРезультатВыполненияЗапроса(Инструменты)

	// Создаем описания параметров для инструмента execute_query
	МассивПараметров = Новый Массив;
	
	// Параметр query - текст запроса 1С для выполнения
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"query",
		"string",
		"Текст запроса 1С (на языке запросов 1С) для выполнения. Не должен содержать параметров - все значения должны быть получены в запросе явно, с помощью простых типов (строки, числа, даты и т.д.)",
		,
		Истина
	));
	
	// Параметр maxRows - максимальное количество строк результата
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"maxRows",
		"number",
		"Максимальное количество строк результата",
		1000
	));
	
	// Параметр format - формат вывода результата
	СписокФорматовВывода = "json,csv";
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"format",
		"string",
		"Формат вывода результата (json - JSON массив, csv - CSV)",
		"json",
		Ложь,
		СписокФорматовВывода
	));
	
	// Создаем JSON-схему параметров
	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);
	
	// Добавляем инструмент в таблицу
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"execute_query",
		"Выполнение запроса 1С и получение результата в различных форматах",
		СхемаПараметров
	);

КонецПроцедуры

Функция ПолучитьРезультатВыполненияЗапроса(Аргументы)

	ТекстЗапроса = Аргументы.query;
	МаксимумСтрок = ?(Аргументы.Свойство("maxRows"), Аргументы.maxRows, 1000);
	Формат = ?(Аргументы.Свойство("format"), Аргументы.format, "json");
	
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст = ТекстЗапроса;
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если РезультатЗапроса.Пустой() Тогда
			Результат = Новый Структура;
			Результат.Вставить("success", Истина);
			Результат.Вставить("rowCount", 0);
			Результат.Вставить("data", "");
			Результат.Вставить("message", "Запрос выполнен успешно, но не вернул данных");
			
			Возврат mcp_ОбщегоНазначения.СтруктураВJSON(Результат);
		КонецЕсли;
		
		// Выгружаем в таблицу значений
		ТаблицаЗначений = РезультатЗапроса.Выгрузить();
		
		// Ограничиваем количество строк
		Пока ТаблицаЗначений.Количество() > МаксимумСтрок Цикл
			ТаблицаЗначений.Удалить(ТаблицаЗначений.Количество() - 1);
		КонецЦикла;
		
		ДанныеДляВывода = "";
		
		Если Формат = "json" Тогда
			// Формируем JSON
			МассивСтрок = Новый Массив;
			
			Для Каждого Строка Из ТаблицаЗначений Цикл
				СтруктураСтроки = Новый Структура;
				
				Для Каждого Колонка Из ТаблицаЗначений.Колонки Цикл
					Значение = Строка[Колонка.Имя];
					СтруктураСтроки.Вставить(Колонка.Имя, Значение);
				КонецЦикла;
				
				МассивСтрок.Добавить(СтруктураСтроки);
			КонецЦикла;
			
			ДанныеДляВывода = mcp_ОбщегоНазначения.СтруктураВJSON(МассивСтрок);
			
		ИначеЕсли Формат = "csv" Тогда
			// Формируем CSV с правильным экранированием
			ДанныеДляВывода = ПреобразоватьТЗвТекстCSV(ТаблицаЗначений);
		КонецЕсли;
		
		Результат = Новый Структура;
		Результат.Вставить("success", Истина);
		Результат.Вставить("rowCount", ТаблицаЗначений.Количество());
		Результат.Вставить("data", ДанныеДляВывода);
		Результат.Вставить("message", "Запрос выполнен успешно");
		
		Возврат mcp_ОбщегоНазначения.СтруктураВJSON(Результат);
		
	Исключение
		Результат = Новый Структура;
		Результат.Вставить("success", Ложь);
		Результат.Вставить("rowCount", 0);
		Результат.Вставить("data", "");
		Результат.Вставить("message", ОписаниеОшибки());
		
		Возврат mcp_ОбщегоНазначения.СтруктураВJSON(Результат);
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПреобразоватьТЗвТекстCSV(ТЗ) Экспорт
		
	МассивСтрок = Новый Массив;
	
	// Добавляем заголовки колонок (всегда)
	МассивЗаголовков = Новый Массив;
	Для Каждого Колонка Из ТЗ.Колонки Цикл
		МассивЗаголовков.Добавить(ЭкранироватьЗначениеCSV(Колонка.Имя));
	КонецЦикла;
	МассивСтрок.Добавить(СтрСоединить(МассивЗаголовков, ","));
	
	// Добавляем строки данных
	Для Каждого Строка Из ТЗ Цикл
		МассивЗначений = Новый Массив;
		
		Для Каждого Колонка Из ТЗ.Колонки Цикл
			Значение = Строка[Колонка.Имя];
			
			// Форматируем числа с точкой как разделителем
			Если ТипЗнч(Значение) = Тип("Число") Тогда
				СтроковоеЗначение = Формат(Значение, "ЧГ=0; ЧРД=.");
			Иначе
				СтроковоеЗначение = Строка(Значение);
			КонецЕсли;
			
			МассивЗначений.Добавить(ЭкранироватьЗначениеCSV(СтроковоеЗначение));
		КонецЦикла;
		
		МассивСтрок.Добавить(СтрСоединить(МассивЗначений, ","));
	КонецЦикла;
	
	Возврат СтрСоединить(МассивСтрок, Символы.ПС);
КонецФункции

Функция ЭкранироватьЗначениеCSV(Значение)

	СтроковоеЗначение = Строка(Значение);
	
	// Проверяем, нужно ли экранирование (содержит запятую, кавычки или переносы строк)
	Если СтрНайти(СтроковоеЗначение, ",") > 0 
		ИЛИ СтрНайти(СтроковоеЗначение, """") > 0 
		ИЛИ СтрНайти(СтроковоеЗначение, Символы.ПС) > 0 
		ИЛИ СтрНайти(СтроковоеЗначение, Символы.ВК) > 0 Тогда
		
		// Экранируем кавычки удвоением и заключаем всё в кавычки
		ЭкранированноеЗначение = СтрЗаменить(СтроковоеЗначение, """", """""");
		Возврат """" + ЭкранированноеЗначение + """";
	Иначе
		Возврат СтроковоеЗначение;
	КонецЕсли;

КонецФункции

#КонецОбласти
