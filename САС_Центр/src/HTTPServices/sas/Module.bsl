#Область СлужебныеПроцедурыИФункции

Функция ОтветСервиса(Знач КодОтвета, Знач ТелоОтветаСтрокой = "")
	
	Ответ = Новый HTTPСервисОтвет(КодОтвета);
	Ответ.УстановитьТелоИзСтроки(ТелоОтветаСтрокой);
	Ответ.Заголовки.Вставить("Content-Type", "text;charset=utf-8");
	
	Возврат Ответ;
	
КонецФункции 

// Вспомогательная функция для парсинга JSON
Функция ЧтениеJSON(СтрокаJSON)
	Поток = Новый ПотокВПамяти;
	Поток.ЗаписатьСтроку(СтрокаJSON, КодировкаТекста.UTF8);
	Читатель = Новый ЧтениеДанных(Поток);
	Результат = Читатель.ПрочитатьJSON();
	Поток.Закрыть();
	Возврат Результат;
КонецФункции

Функция GetInfo(Запрос)
	
	ОтветСтрокой = Запрос.ПолучитьТелоКакСтроку();
	
	ЧтениеJSON = Новый ЧтениеJSON();
	ЧтениеJSON.УстановитьСтроку(ОтветСтрокой);
	ТекОшибка = ПрочитатьJSON(ЧтениеJSON);
	ЧтениеJSON.Закрыть();
	
	ХэшПриложения = САС_Сервер.ЗначениеСвойства(ТекОшибка, "appStackHash");
	Если ХэшПриложения <> Неопределено Тогда
		ХэшОшибки = ТекОшибка.configHash + "-" + ТекОшибка.clientStackHash + "-" + ХэшПриложения;
	КонецЕсли;
	
	ТекЗадача = САС_Сервер.НайтиХэш(ХэшОшибки);
	Если ТекЗадача = Неопределено Тогда
		// Это первый вызов
		Если ХэшПриложения <> Неопределено Тогда
			НоваяЗапись = РегистрыСведений.Инциденты.СоздатьМенеджерЗаписи();
			НоваяЗапись.Хэш =   ХэшОшибки;
			НоваяЗапись.Записать();
		КонецЕсли; 
		
		ДанныеОтвета = Новый Структура;
		ДанныеОтвета.Вставить("needSendReport", Истина); 
		ДанныеОтвета.Вставить("userMessage", "Отчет об обшибке получен. Мы исправим ошибку быстро как только сможем.");
		ДанныеОтвета.Вставить("dumpType", 1);
	ИначеЕсли ТекЗадача.Пустая() Тогда  
		// Ошибка зарегистрирована, но Задача еще не создана
		ДанныеОтвета = Новый Структура;
		ДанныеОтвета.Вставить("needSendReport", Ложь); 
		ДанныеОтвета.Вставить("userMessage", "Данная ошибка уже зарегистрирована и обрабатывается.");
		ДанныеОтвета.Вставить("dumpType", 0);
	Иначе 
		// Есть задача для ошибки
		ДанныеОтвета = Новый Структура;
		ДанныеОтвета.Вставить("needSendReport", Ложь); 
		ДанныеОтвета.Вставить("userMessage", "Данная ошибка уже зарегистрирована. Номер задачи #" + ТекЗадача.Код);
		ДанныеОтвета.Вставить("dumpType", 0);
	КонецЕсли; 
	
	ЗаписьJSON = Новый ЗаписьJSON;			
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, ДанныеОтвета);			
	
	ДанныеОтветаСтрокой = ЗаписьJSON.Закрыть();
	
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.УстановитьТелоИзСтроки(ДанныеОтветаСтрокой);
	
	Возврат Ответ;
	
КонецФункции

