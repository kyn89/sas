Функция ПрочитатьтекстЗапроса(Содержимое)

	Попытка
		ЧтениеJSON = новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(Содержимое);
		ПолученныйОтвет = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
	Исключение
		ПолученныйОтвет = "";
	КонецПопытки;
	
	Возврат  ПолученныйОтвет;
КонецФункции

// Функция - Подготовить ответ
//
// Параметры:
//  ОбъектСДанными	 - Структура  -  с данными для превращения в текст JSON	 
// 
// Возвращаемое значение:
//   - Строка в формате JSON
//
Функция ПодготовитьОтвет(ОбъектСДанными) Экспорт
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON,ОбъектСДАнными);
	ТекстОтвета = ЗаписьJSON.Закрыть();
	
	Возврат  ТекстОтвета;
КонецФункции

